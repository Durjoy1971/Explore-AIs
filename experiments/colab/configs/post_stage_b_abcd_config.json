{
  "run_name": "post_stage_b_abcd_v2",
  "run_mode": "experiments_abcd",
  "experiments": ["A", "B", "C", "D"],
  "models": [
    "csebuetnlp/banglabert",
    "google/muril-base-cased",
    "xlm-roberta-base",
    "distilbert-base-multilingual-cased"
  ],
  "text_views": ["raw", "canon_masked", "brand_masked", "brand_stripped"],
  "folds": [0, 1, 2, 3, 4],
  "epochs": 3,
  "batch_size": 32,
  "eval_batch_size": 64,
  "learning_rate": 3e-5,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "max_length": 128,
  "seed": 42,
  "fp16": "auto",
  "experiment_b_balance_mode": "class_weight",
  "run_heldout_eval": true,
  "run_adversarial_eval": true,
  "run_counterfactual_eval": true,
  "keep_model_weights": "none",
  "smoke_max_train_samples": null,
  "smoke_max_val_samples": null,
  "smoke_max_eval_samples": null
}
